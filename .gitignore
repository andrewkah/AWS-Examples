# ------------------------------------------------------------------------
# Terraform Core Directory
# ------------------------------------------------------------------------
# Contains downloaded plugins (providers), modules, and local state backup.
.terraform/

# ------------------------------------------------------------------------
# Terraform State Files
# ------------------------------------------------------------------------
# State files contain the actual architecture layout and sensitive secrets.
# These MUST be kept in a remote backend (e.g., S3, GCS) instead of Git.
*.tfstate
*.tfstate.*

# ------------------------------------------------------------------------
# Crash Logs
# ------------------------------------------------------------------------
# Generated automatically if Terraform crashes.
crash.log
crash.*.log

# ------------------------------------------------------------------------
# Variables and Secrets
# ------------------------------------------------------------------------
# Exclude all variable files because they often contain passwords and tokens.
*.tfvars
*.tfvars.json

# Ignore local override files used for localized testing
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ------------------------------------------------------------------------
# CLI Configuration and Plan Outputs
# ------------------------------------------------------------------------
# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore speculative execution plans generated by 'terraform plan -out=...'
*tfplan*
