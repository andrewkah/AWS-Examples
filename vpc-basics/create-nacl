#!/usr/bin/env bash
echo "Create a NACL for a VPC..."

if ! command -v aws &> /dev/null
then
    echo "aws cli command is required"
    exit 1
fi
# List the available vpcs
./vpc-basics/list-vpc

while [ -z $VPC_ID ]; do
    read -rp "Enter your VPC Id:" VPC_ID
done

OUTPUT=$(aws ec2 create-network-acl vpc_id $VPC_ID --output json 2>&1)
STATUS=$?
if [ $STATUS -eq 0 ];then
    echo "$OUTPUT"
    exit 0
else
    echo "Error occured when creating NACL: $OUTPUT"
fi