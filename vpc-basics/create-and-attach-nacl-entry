#!/usr/bin/env bash

echo "Create a NACL entry to deny access to a VPC..."

if ! command -v aws &> /dev/null
then
    echo "aws cli command is required"
    exit 1
fi

# Listing the available VPCs and attached NACl
OUTPUT=$(aws ec2 describe-vpcs --region us-east-1 \
--query "Vpcs[*].{ID:VpcId,Name:Tags[?Key=='Name']|[0].Value,CIDR:CidrBlock,State:State}" \
--output table 2>&1)
STATUS=$?
if [ $STATUS -eq 0 ]; then
    echo "$OUTPUT"
else
    echo "Error retrieving VPCs: $OUTPUT"
    exit 1
fi

while [[ -z "$VPC_ID" ]]; do
    read -rp "Please enter your VPC ID: " VPC_ID
done

echo "Looking up Network ACL ID for VPC $VPC_ID..."
NACL_ID=$(aws ec2 describe-network-acls \
    --filters "Name=vpc-id,Values=$VPC_ID" \
    --query "NetworkAcls[0].NetworkAclId" \
    --output text)

# Validate that we found a valid NACL ID
if [[ -z "$NACL_ID" || "$NACL_ID" == "None" ]]; then
    echo "Error: Could not find a Network ACL for VPC $VPC_ID"
    exit 1
fi

# ask for the cidr block
while [[ -z "$CIDR_BLOCK" ]]; do
    read -rp "Please enter the IP address: " CIDR_BLOCK
done

# Add ingress nacl entry with rule number 90, protocol -1, action allow and cidr block 0.0.0.0/0
OUTPUT_2=$(aws ec2 create-network-acl-entry \
    --network-acl-id "$NACL_ID" \
    --rule-number 90 \
    --ingress \
    --protocol -1 \
    --rule-action deny \
    --cidr-block "$CIDR_BLOCK" 2>&1)
STATUS_0=$?
if [ $STATUS_0 -eq 0 ]; then
    echo "NACL entry created succesfully"
    exit 0
else
    echo "Error occured when creating NACL: $OUTPUT_2"
    exit 1
fi